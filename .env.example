# Stellar Network RPC URLs
MAINNET_RPC_URL=https://mainnet.stellar.validationcloud.io/v1/<YOUR_API_KEY>
TESTNET_RPC_URL=https://soroban-testnet.stellar.org
FUTURENET_RPC_URL=https://rpc-futurenet.stellar.org:443

# Secret Keys (never commit real keys)
MAINNET_SECRET_KEY=your_mainnet_secret_key_here
TESTNET_SECRET_KEY=your_testnet_secret_key_here
FUTURENET_SECRET_KEY=your_futurenet_secret_key_here

# App Configuration
PORT=3000
NETWORK=testnet
NODE_ENV=development
SIMULATE_TIMEOUT_MS=30000

# Grafana Configuration (for docker-compose.prod.yml)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Redis Configuration (optional — enables Redis cache backend when set)
# REDIS_URL=rediss://localhost:6379

# Redis Sentinel Configuration (optional — for high-availability deployments)
# REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster

# Redis Cluster Configuration (optional — for horizontal scaling)
# REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379
# REDIS_CLUSTER_MAX_REDIRECTIONS=16

# Cache Compression (optional — reduces Redis memory usage for large payloads)
# CACHE_COMPRESSION_ENABLED=true
# CACHE_COMPRESSION_THRESHOLD=512

# Cache Memory Pressure Handling
# CACHE_HEAP_SAFETY_THRESHOLD=0.85
# CACHE_EMERGENCY_TRIM_RATIO=0.25

# Cache Warming Worker (optional — pre-populates cache for popular contracts)
# ENABLE_CACHE_WARMING=true
# CACHE_WARMING_CONTRACTS='[{"contractId":"CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC","method":"balance","args":[]}]'
# CACHE_WARMING_INTERVAL_MS=30000

# Compression (bytes, default: 1024)
COMPRESSION_THRESHOLD=1024

# RPC connection pool TTL (ms, default: 300000 = 5 min)
RPC_POOL_TTL_MS=300000

# Logging (debug | info | warn | error, default: info)
LOG_LEVEL=info

# Simulation LRU cache
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=500

# Batch simulation max transactions per request (default: 10)
BATCH_MAX_SIZE=10

# Rate limiting for /api/simulate (per IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Rate limiting for /decode (per IP)
DECODE_RATE_LIMIT_MAX=120
DECODE_RATE_LIMIT_WINDOW_MS=60000

# Rate limiting for /estimate-fee (per IP)
FEE_RATE_LIMIT_MAX=60
FEE_RATE_LIMIT_WINDOW_MS=60000

# Network status cache TTL (ms, default: 10000 = 10 s)
# NETWORK_STATUS_TTL_MS=10000

# HTTP server keep-alive / headers timeouts (ms)
# Set headersTimeout > keepAliveTimeout to avoid race conditions with load balancers
# KEEP_ALIVE_TIMEOUT_MS=65000
# HEADERS_TIMEOUT_MS=66000
