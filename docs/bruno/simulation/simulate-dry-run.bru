meta {
  name: Simulate Dry Run
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/simulate/dry-run
  body: json
  auth: none
}

body:json {
  {
    "xdr": "{{sampleTxXdr}}",
    "network": "{{network}}"
  }
}

tests {
  test("should return 200 OK with dryRun metadata", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().dryRun).to.equal(true);
  });
}
