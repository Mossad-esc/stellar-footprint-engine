meta {
  name: Footprint Diff
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/footprint/diff
  body: json
  auth: none
}

body:json {
  {
    "before": {
      "readOnly": [],
      "readWrite": []
    },
    "after": {
      "readOnly": [
        "{{sampleLedgerKeyXdr}}"
      ],
      "readWrite": []
    }
  }
}

tests {
  test("should return 200 OK with footprint diff", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.added.readOnly).to.be.an("array");
  });
}
